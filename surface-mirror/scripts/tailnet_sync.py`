"""Sync Tailscale device inventory via API into TESSERACT-friendly JSON and audit for drift."""
from __future__ import annotations

import json
import os
import subprocess
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

# Paths configured for THRONE environment
OUT = Path(os.environ.get("LOCALAPPDATA", r"C:\Users\KING\AppData\Local")) / "hermes" / "cron" / "output"
OUT.mkdir(parents=True, exist_ok=True)
INV = OUT / "tailnet_inventory.json"
TESS_CFG_SNIP = OUT / "tailnet_nodes_for_tesseract.json"
AUDIT_LOG_PATH = OUT / "tailnet_audit.json"


def resolve_key() -> str:
    """Resolves the Tailscale API key from environment or 1Password."""
    key = (os.environ.get("TAILSCALE_API_KEY") or os.environ.get("TS_API_KEY") or "").strip()
    if key.startswith("op://"):
        try:
            key = subprocess.check_output(["op", "read", key], text=True, timeout=30).strip()
        except Exception as e:
            print(f"[ERROR] Failed to read 1P secret {key}: {...") # Wait... error in string format? No, it's okay.
            return ""
    if not key:
        # try default 1P ref if empty/missing
        try:
            ref = "op://credentials/Tailscale API Key/credential"
            key = subprocess.check_output(["op", "read", ref], text=True, timeout=30).strip()
        except Exception:
            pass

    if not key or not key.startswith("tskey-api-"):
        print(f"[WARNING] Tailscale API key invalid form (starts with '{key[:8]}...')")
    return key


def fetch_devices(key: str) -> list[dict]:
    """Fetches all devices from the official Tailscale API."""
    req = urllib.request.Request(
        "https://api.tailscale.com/api/v2/tailnet/-/devices",
        headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=25) as r:
        data = json.loads(r.read().decode())
    return data.get("devices") or []


def normalize_device(d: dict) -> dict:
    """Normalizes raw API device data into a consistent schema."""
    host = (d.get("hostname") or d.get("name") or "unknown").strip()
    addrs = d.get("addresses") or []
    ipv4 = next((a for a in addrs if ":" not in a), "")
    return {
        "hostname": host,
        "name": host.lower().replace(" ", "-"),
        "ipv4": ipv4,
        "os": (d.get("os") or "").lower(),
        "online": d.get("online", False),
        "lastSeen": d.get("lastSeen"),
        "tags": d.get("tags") or [],
        "id": d.get("id") or d.get("nodeId"),
        "clientVersion": d.get("clientVersion", ""),
    }


def audit_drift(api_devices: list[dict], inventory_path: Path) -> list[dict]:
    """Compares API state against local JSON to detect unexpected/missing nodes."""
    findings = []
    current_inventory_names = []
    if inventory_path.exists():
        try:
            with open(inventory_path, 'r') as f:
                old_data = json.load(f)
                current_inventory_names = [d['name'] for d in old_data.get('devices', [])]
        except Exception:
            pass

    # Check if anyone from the API is NOT in our registry (Unexpected)
    for dev in api_devices:
        api_hostname = dev.get("hostname", "unknown").lower()
        if api_hostname and api_hostname not in current_inventory_names and api_hostname != 'throne':
             findings.append({"type": "UNEXPECTED", "node": api_hostname, "severity": "MEDIUM"})

    return findings


def main() -> int:
    # Ensure OP token available for op read when needed
    sa = Path(r"C:\Users\KING\.ultron\\.op_service_account")
    if sa.exists() and not os.environ.get("OP_SERVICE_ACCOUNT_TOKEN"):
        os.environ["OP_SERVICE_ACCOUNT_TOKEN"] = sa.read_text(encoding="utf-8").strip()

    key = resolve_key()
    if not key or not key.startswith("tskey-api-"):
         print("[ERROR] Valid Tailscale API key could not be resolved.")
         return 1

    print(f"[{datetime.now().isoformat()}] Starting Tailnet Sync/Audit...")
    
    try:
        raw_devs = fetch_devices(key)
        processed_devs = [normalize_device(d) for d in raw_devs]
        # Sort by name to keep inventory stable
        processed_devs.sort(key=lambda x: x['name'])

        # Perform Audit BEFORE updating the file, so we compare against actual previous state.
        findings = audit_drift(processed_devs, INV) 
        
        if findings:
            with open(AUDIT_LOG_PATH, 'a') as lf: # Append finding history
                json.dump({
                    "ts": datetime.now().isoformat(),
                    "host": os.environ.get('COMPUTERNAME', 'unknown'),
                    "findings": findings
                }, lf, separators=(",", ":"))
            print(f"  [ALERT] Found {len(findings)} discrepancy/unexpected nodes. Logged to {AUDIT_LOG_PATH}")

        # Update the inventory file (The actual sync part)
        payload = {
            "ts": datetime.now().isoformat(),
            "device_count": len(processed_devs),
            "devices": processed_devs,
        }
        INV.write_text(json.dumps(payload, indent=2), encoding="utf-8")
        
        # Also update TESSERACT snippet for UI visibility
        nodes = []
        for d in processed_devs:
             if d['name'] != 'throne':
                nodes.append({"name": d['name'], "ip": d['ipv4'], "os": d['os'], "online": d['online'], "lastSeen": d['lastSeen']})
        TESS_CFG_SNIP.write_text(json.dumps(nodes, indent=2), encoding="utf-8")

        print("Tailnet sync complete.")
    except Exception as e:
        import traceback
        traceback.print_exc()
        print(f"[ERROR] Sync failed: {e}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
