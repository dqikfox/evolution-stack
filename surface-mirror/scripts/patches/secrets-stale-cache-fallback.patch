@@ -238,6 +272,47 @@ def _human_age(seconds: float) -> str:
     return f"{seconds / 86400.0:.0f} days"
 
 
+# How long the breaker stays open after a total failure. Long enough for
+# a 1Password rate-limit window to actually expire, short enough that a
+# genuinely fixed account is picked up again without a manual nudge.
+_BREAKER_COOLDOWN = 15 * 60
+
+_BREAKER_BASENAME = "op_breaker.json"
+
+
+def _breaker_path(home_path: Optional[Path]) -> Path:
+    home = Path(home_path) if home_path is not None else Path(__file__).resolve().parents[3]
+    return home / "cache" / _BREAKER_BASENAME
+
+
+def _breaker_state(cache_key: _CacheKey, home_path: Optional[Path]) -> dict:
+    try:
+        path = _breaker_path(home_path)
+        if not path.exists():
+            return {}
+        data = json.loads(path.read_text(encoding="utf-8"))
+        entry = data.get(_disk_key_str(cache_key))
+        return entry if isinstance(entry, dict) else {}
+    except Exception:
+        return {}
+
+
+def _set_breaker(cache_key: _CacheKey, home_path: Optional[Path], open_until: float) -> None:
+    try:
+        path = _breaker_path(home_path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
+        except Exception:
+            data = {}
+        if not isinstance(data, dict):
+            data = {}
+        data[_disk_key_str(cache_key)] = {"open_until": float(open_until)}
+        path.write_text(json.dumps(data, indent=2), encoding="utf-8")
+    except Exception:
+        pass
+
+
 def _missing_binary_error(binary_path: str) -> str:
     if binary_path:
         return f"secrets.onepassword.binary_path ({binary_path!r}) is not an executable op binary."
