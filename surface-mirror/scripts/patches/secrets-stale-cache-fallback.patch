+    # CIRCUIT BREAKER. If the last pull failed completely, and it failed
+    # recently, do not try again yet - go straight to the cache.
+    #
+    # The resolver reads one secret per `op read` subprocess, so a house
+    # with two dozen secrets makes two dozen requests, and 1Password
+    # rate-limits service accounts aggressively. Once the limit is hit,
+    # every one of those requests FAILS - and each failure is another
+    # request, so a retry loop EXTENDS the rate limit. On 2026-10-27 the
+    # gateway was restarted into that loop and the Telegram channel went
+    # fatal because the bot token could not be read.
+    #
+    # So: a total failure opens the breaker for a cooldown. While it is
+    # open, pulls use the cache and make no requests at all. That is the
+    # only way to let the limit actually expire.
+    if use_cache:
+        breaker = _breaker_state(cache_key, home_path)
+        if breaker.get("open_until", 0) > time.time():
+            stale = _STORE.lookup_stale(cache_key, home_path)
+            if stale is not None and stale.secrets:
+                warnings.append(
+                    f"1Password is in a rate-limit cooldown; using the cached "
+                    f"values from {_human_age(time.time() - stale.fetched_at)} "
+                    f"ago without contacting 1Password.")
+                return dict(stale.secrets), warnings
+
